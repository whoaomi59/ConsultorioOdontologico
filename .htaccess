<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirigir la raíz al subdirectorio /public
    RewriteRule ^$ public/ [L]
    
    # Redirigir todas las demás peticiones a public/index.php enviando la variable 'url'
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
</IfModule>